{
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/austin/dotfiles/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.34",
    "padding": 0
  },
  "enabledPlugins": {
    "superpowers@austin-plugins": true
  },
  "extraKnownMarketplaces": {
    "austin-plugins": {
      "source": {
        "source": "github",
        "repo": "austindreyer/claude-marketplace"
      }
    }
  }
}
